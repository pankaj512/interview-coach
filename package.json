{
  "name": "interview-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @interview-coach/api dev",
    "dev:web": "pnpm --filter @interview-coach/web dev",
    "dev": "pnpm --parallel --filter @interview-coach/api --filter @interview-coach/web dev",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
