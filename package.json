{
  "name": "interview-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @interview-coach/backend dev",
    "dev:web": "pnpm --filter @interview-coach/web-client dev",
    "dev": "pnpm --parallel --filter @interview-coach/backend --filter @interview-coach/web-client dev",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
