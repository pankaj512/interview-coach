# Server-only. Never prefix Azure vars with VITE_ and never import them in packages/web-client.
AZURE_VOICE_ENDPOINT=https://interview-coach-voice.services.ai.azure.com
AZURE_VOICE_API_KEY=
AZURE_VOICE_MODEL=gpt-realtime-mini
AZURE_VOICE_API_VERSION=2026-04-10
AZURE_VOICE_VOICE=en-US-Andrew:DragonHDLatestNeural

# Ephemeral voice token minting (Fastify). TTL seconds.
VOICE_EPHEMERAL_TTL_SECONDS=600

# Tool-call reliability defaults (locked unless ADR).
TOOL_EXEC_TIMEOUT_MS=8000
TOOL_EXEC_MAX_RETRIES=2
TOOL_IDEMPOTENCY_TTL_MINUTES=30

# Postgres (local dev only values).
POSTGRES_DB=interview_coach
POSTGRES_USER=coach
POSTGRES_PASSWORD=coach_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://coach:coach_dev_only@localhost:5432/interview_coach

# Client only needs backend URL. No secrets here.
VITE_BACKEND_URL=http://localhost:3000
