# Backend (Fastify, S3). Listens on HOST:PORT; CORS origin is the web client
# (S6). Comma-separate multiple origins (Vite prints 127.0.0.1; both are allowed
# by default).
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Server-only. Never prefix Azure vars with VITE_ and never import them in packages/web-client.
AZURE_VOICE_ENDPOINT=https://interview-coach-voice.services.ai.azure.com
AZURE_VOICE_API_KEY=
AZURE_VOICE_MODEL=gpt-realtime-mini
AZURE_VOICE_API_VERSION=2026-04-10
# Realtime voice: closed set (alloy, ash, ballad, coral, echo, sage,
# shimmer, verse, marin, cedar). Azure speech names are rejected.
AZURE_VOICE_VOICE=alloy

# Ephemeral voice token minting (Fastify). TTL seconds.
VOICE_EPHEMERAL_TTL_SECONDS=600
# V3-5: api-key voice mode returns the long-lived AZURE_VOICE_API_KEY verbatim
# and is local-dev only. In production the process refuses to start with that
# key set unless ALLOW_INSECURE_VOICE_API_KEY=true (explicit opt-in).
ALLOW_INSECURE_VOICE_API_KEY=

# Tool-call reliability defaults (locked unless ADR).
TOOL_EXEC_TIMEOUT_MS=8000
TOOL_EXEC_MAX_RETRIES=2
TOOL_IDEMPOTENCY_TTL_MINUTES=30

# S8a hardening: service auth + abuse quotas. When API_AUTH_TOKEN is set, all
# /api routes except GET /api/health and GET /api/ready require
# `Authorization: Bearer <token>` (CLI: send the header; browser: same).
# Unset = open local-dev mode (startup warning). Per-user ownership
# (Entra/OIDC) stays on the S8b deploy track.
API_AUTH_TOKEN=
# F7-4/F8-2: production refuses to boot open. With NODE_ENV=production and no
# API_AUTH_TOKEN, set ALLOW_ANONYMOUS=true to run open explicitly (demo only).
ALLOW_ANONYMOUS=
RATE_LIMIT_GLOBAL_PER_MIN=1000
RATE_LIMIT_TOOL_EXEC_PER_MIN=120
RATE_LIMIT_VOICE_MINT_PER_MIN=60
RATE_LIMIT_CODE_RUN_PER_MIN=30
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_RECOMMENDATION_PER_MIN=30
VOICE_MAX_ACTIVE_SESSIONS=200
CODE_RUN_MAX_CONCURRENT=4
CODE_RUN_MAX_SUBMISSIONS_PER_INTERVIEW=100
# S8c accounts (HLD 7.1): opaque session lifetime for self-registered logins.
# F7-3: 7-day default (168h); raise deliberately, not by accident.
AUTH_SESSION_TTL_HOURS=168

# Code sandbox (feature 16 Docker runner, HLD Phase 6). Per-run containers
# with --network=none + memory/CPU/pids caps; wall-clock kill per run +
# output caps. Images must be pre-pulled or pullable; without a daemon,
# runs persist as `error` runs.
CODE_RUN_TIMEOUT_MS=5000
CODE_RUN_MAX_OUTPUT_CHARS=20000
# Per-run container images (one pull covers C++ and Python via gcc image).
# The backend lazily pulls missing images on first use; without a reachable
# daemon, runs persist as `error` runs.
SANDBOX_IMAGE_JS=node:24-slim
SANDBOX_IMAGE_PY=gcc:14-bookworm
SANDBOX_IMAGE_CPP=gcc:14-bookworm
# Per-run container caps passed as docker run flags.
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128

# Learning-loop Phase 4: server-side recommendation LLM (ADR-002). A separate
# Azure AI Foundry text deployment; the credential is NEVER exposed to the
# browser and is never a realtime tool. Leave LLM_ENDPOINT/LLM_API_KEY blank
# for local dev — the recommendation service then uses its deterministic
# fallback, so the learning loop still works end to end.
LLM_ENDPOINT=
LLM_API_KEY=
LLM_DEPLOYMENT=gpt-4o-mini
LLM_API_VERSION=2024-10-21
LLM_TIMEOUT_MS=10000
LLM_MAX_RETRIES=2

# Postgres (local dev only values).
POSTGRES_DB=interview_coach
POSTGRES_USER=coach
POSTGRES_PASSWORD=coach_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://coach:coach_dev_only@localhost:5432/interview_coach

# Client only needs backend URL. No secrets here.
VITE_BACKEND_URL=http://localhost:3000
# S8a: optional local-dev token for a token-gated backend (ships in the
# bundle when set — never use outside local development).
VITE_API_TOKEN=
